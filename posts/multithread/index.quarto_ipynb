  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d7d47333",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| eval: false\n",
    "#| code-fold: false\n",
    "\n",
    "import asyncio\n",
    "\n",
    "\n",
    "async def fetch(name, delay):  # 1. async def => coroutine function\n",
    "    print(f\"{name} start\")\n",
    "    await asyncio.sleep(delay)  # 2. suspend here, let others run\n",
    "    print(f\"{name} done\")\n",
    "    return name\n",
    "\n",
    "\n",
    "async def main():  # 3. anything that awaits must be async\n",
    "    results = await asyncio.gather(  # 4. run all three concurrently\n",
    "        fetch(\"A\", 1),\n",
    "        fetch(\"B\", 1),\n",
    "        fetch(\"C\", 1),\n",
    "    )\n",
    "    print(results)\n",
    "\n",
    "\n",
    "asyncio.run(main())  # 5. the ONE sync->async boundary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "7c2746e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| eval: false\n",
    "#| code-fold: false\n",
    "\n",
    "balance = 100\n",
    "\n",
    "\n",
    "async def withdraw(amount):\n",
    "    global balance\n",
    "    if balance >= amount:  # (1) CHECK\n",
    "        await asyncio.sleep(0.01)  # (2) SUSPEND — other tasks run here\n",
    "        balance -= amount  # (3) ACT on a now-stale check\n",
    "\n",
    "\n",
    "async def main():\n",
    "    await asyncio.gather(withdraw(100), withdraw(100))\n",
    "    print(balance)  # -100. Both passed the check before either subtracted."
   ]
  }
 ],
